# ==============================================================================
# ALGODESK CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your private credentials.
# NEVER commit .env to source control!
# ==============================================================================

# Core System Mode & Safety Gates
# LIVE mode strictly requires ALGODESK_ALLOW_LIVE=true, strategy live_enabled: true,
# AND an explicit confirmation action in the dashboard each trading day.
ALGODESK_ALLOW_LIVE=false
ALGODESK_ENV=development # development | production

# Zerodha Kite Connect API Credentials
# Sessions expire daily; TOTP 2FA means login cannot be fully automated.
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_ACCESS_TOKEN=your_daily_access_token_here

# PostgreSQL / TimescaleDB
DATABASE_URL=postgresql://algodesk:algodesk_secure_pass@localhost:5432/algodesk
POSTGRES_USER=algodesk
POSTGRES_PASSWORD=algodesk_secure_pass
POSTGRES_DB=algodesk

# Redis (Caching, Locks, Tick Stream & In-Memory Sessions)
REDIS_URL=redis://localhost:6379/0

# Google Gemini AI Layer (google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_DAILY_BUDGET_CALLS=200

# Telegram Bot (Real-time Execution Alerts & Remote Kill Switch)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web Dashboard Security
APP_SECRET_KEY=change_this_to_a_random_32_char_secret_string
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
DASHBOARD_TOTP_SECRET=

# Data & Storage Paths
DATA_DIR=data
RESULTS_DIR=results
CONFIGS_DIR=configs
STRATEGIES_USER_DIR=strategies_user
